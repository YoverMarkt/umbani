{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/*.spec.ts",
        "scripts/*.mjs"
      ]
    },
    "server": {
      "entry": [
        "src/index.ts",
        "tests/*.mjs",
        "evals/*.mjs"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/admin": {
      "entry": [
        "index.html"
      ]
    },
    "apps/client": {
      "entry": [
        "index.html"
      ]
    },
    "apps/cooperativa": {
      "entry": [
        "index.html"
      ]
    },
    "apps/store": {
      "entry": [
        "index.html",
        "u.html",
        "r.html",
        "src/umbani/main.tsx",
        "src/repartidor/main.tsx",
        "tests/*.test.ts"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignore": [
    "apps/*/public/theme-boot.js",
    "apps/store/public/sw.js",
    "server/src/services/platform-pricing.ts"
  ],
  "ignoreDependencies": [
    "class-variance-authority",
    "clsx",
    "radix-ui",
    "tailwind-merge"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "unlisted": "warn"
  },
  "ignoreBinaries": [
    "supabase",
    "psql"
  ]
}
