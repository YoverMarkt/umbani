{
  "name": "@botpanel/server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --ignore dist --exec \"npm run build && node dist/index.js\"",
    "pretest": "npm run build",
    "test": "vitest run tests/",
    "lint": "eslint eslint.config.js tests && oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify:schema": "bash tests/sql/verificar-en-docker.sh",
    "evals": "npm run build && node evals/runner.mjs",
    "verify:drift": "bash tests/sql/comparar-con-produccion.sh",
    "verify:smoke": "node --env-file=.env tests/humo-produccion.mjs",
    "verify:deploy": "node --env-file=.env tests/verificar-despliegue.mjs",
    "migrate:status": "node --env-file=.env tests/migraciones.mjs status",
    "migrate:baseline": "node --env-file=.env tests/migraciones.mjs baseline",
    "migrate": "node --env-file=.env tests/migraciones.mjs apply",
    "errores": "node --env-file=.env tests/errores-resueltos.mjs",
    "admin:reiniciar-codigos": "node --env-file=.env tests/reiniciar-segundo-paso.mjs",
    "test:coverage": "vitest run tests/ --coverage",
    "test:recorridos": "npm run build && vitest run --config vitest.recorridos.config.mjs",
    "test:carga": "node tests/carga-staging.mjs",
    "pretest:coverage": "npm run build",
    "backup": "node --env-file=.env tests/respaldo.mjs backup",
    "backup:verify": "node --env-file=.env tests/respaldo.mjs verify",
    "staging:preparar": "node tests/staging.mjs preparar",
    "dev:staging": "npm run build && node tests/staging.mjs servidor",
    "verify:smoke:staging": "node tests/staging.mjs humo",
    "staging:remoto": "npm run build && node tests/staging-remoto.mjs",
    "tipos:generar": "node --env-file=.env tests/tipos-generados.mjs",
    "tipos:verificar": "node --env-file=.env tests/tipos-generados.mjs --verificar"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/supabase-js": "^2.43.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.0",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
