# ============================================================
# BOTPANEL SAAS — Plantilla de variables de entorno
# Copia este archivo a .env y llena los valores.
# NUNCA pongas valores reales aquí ni subas tu .env a git.
# ============================================================

# ── SUPABASE ──────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=                    # https://xxxx.supabase.co
SUPABASE_KEY=                    # anon / publishable (pública)
SUPABASE_SERVICE_KEY=            # secret / service_role (SOLO servidor, bypassa RLS)

# ── MIGRACIONES (solo para `npm run migrate`, no para el servidor) ─
# Conexión DIRECTA de Postgres: Supabase → Settings → Database → Connection
# string → URI. NO es SUPABASE_URL, que apunta a la API.
# Es credencial de herramienta: se queda en tu .env local y NO va a Railway —
# el servidor en marcha nunca aplica migraciones solo.
DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────
# Frase de 32+ caracteres (genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=

# ── SUPERADMIN (login de /admin — vive solo en el entorno) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=                 # mínimo 12 caracteres

# ── IA (opcional aquí: lo normal es guardarlas en el panel) ─
# El proveedor activo y las keys se administran en Admin → Configuración.
# Estas son solo respaldo del .env.
GROQ_API_KEY=                    # console.groq.com/keys (gratis)
GEMINI_API_KEY=                  # aistudio.google.com/apikey (gratis)
OPENAI_API_KEY=                  # platform.openai.com
ANTHROPIC_API_KEY=               # console.anthropic.com

# ── TELEGRAM (bot compartido para pruebas) ────────────────
TELEGRAM_BOT_TOKEN=              # @BotFather → /newbot
# Secreto aleatorio de 32+ caracteres para validar X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ── SEGURIDAD DE WEBHOOKS ───────────────────────────────
# YCloud: lo preferido es guardar el Endpoint ID y el signing secret por negocio.
# Fallback global opcional para una cuenta/endpoint compartido.
# YCloud envía la firma oficial en la cabecera YCloud-Signature.
YCLOUD_WEBHOOK_ENDPOINT_ID=
YCLOUD_WEBHOOK_SECRET=
# Meta: token del handshake y secreto de la app para verificar la firma HMAC.
META_VERIFY_TOKEN=
META_APP_SECRET=
# Versión vigente por defecto: v25.0. Solo cambia esto al validar una migración.
META_GRAPH_API_VERSION=v25.0

# ── PAGO CON TARJETA (PayPhone) ─────────────────────────
# SOLO aquí (Railway → Variables), nunca en el panel: el token decide a qué
# cuenta va el dinero de cada tarjeta. Las tres o ninguna: con una que falte,
# o con un modo que no sea exactamente `pruebas` o `produccion`, la tarjeta no
# se ofrece en ningún local. Sale de PayPhone Developer → tu aplicación.
# ⚠️ En `pruebas` PayPhone aprueba TODO sin cobrar: la tarjeta solo aparece en
# los locales que el superadmin puso en «Pruebas».
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_MODO=                  # pruebas | produccion

# ── SERVIDOR / PRODUCCIÓN ─────────────────────────────────
PORT=3000
NODE_ENV=                       # production en Railway; vacío en desarrollo
# En producción: tu dominio fijo (sin / al final). Esto DESACTIVA el túnel local.
# Ej: BASE_URL=https://tubot.up.railway.app
BASE_URL=

# ── NOTA ──────────────────────────────────────────────────
# Las credenciales de WhatsApp por cliente (YCloud/Meta) NO van aquí:
# se guardan por negocio en la base de datos desde el panel admin.
